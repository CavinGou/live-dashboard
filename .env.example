# Device tokens: format is token:device_id:device_name:platform
DEVICE_TOKEN_1=changeme_token1:my-pc:My PC:windows
DEVICE_TOKEN_2=changeme_token2:my-phone:My Phone:android

# HMAC secret for hashing window_title (used for dedup, prevents rainbow table attacks)
# Generate with: openssl rand -hex 32
HASH_SECRET=changeme_generate_a_random_secret

# Optional site customization
DISPLAY_NAME=Monika
SITE_TITLE=Monika Now
SITE_DESC=What is Monika doing right now?
SITE_FAVICON=/favicon.ico

# Wallpaper rotation interval in minutes (default: 30)
# WALLPAPER_ROTATION_MINUTES=30

# AI summary — API connection (required for AI summaries)
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=sk-xxx
# AI_API_STYLE=chat
# AI_MODEL=gpt-4o-mini
# AI_MAX_TOKENS=100000
# DeepSeek 默认关闭思考模式，避免摘要输出为空
# AI_THINKING=disabled
# AI_REASONING_EFFORT=low

# AI summary — system prompt (optional)
# AI_PROMPT_FILE = /app/ai-prompt.txt
